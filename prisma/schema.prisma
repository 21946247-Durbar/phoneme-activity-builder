// Prisma schema for Phoneme Activity Builder (Assessment 3)
// Now includes observability models: PageVisit, GenerationEvent, ActivityLog
// Database: SQLite
// Author: Sudipta Biswas Durbar (21946247)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A named collection of phoneme-based words (e.g., "3-Phoneme Words")
model WordList {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words      Word[]
  activities Activity[]
}

/// A single English word stored with its phoneme transcription.
/// Phonemes are stored as separate rows in WordPhoneme to support
/// multi-character IPA symbols (e.g., /tʃ/, /iː/, /æɪ/).
model Word {
  id            Int      @id @default(autoincrement())
  listId        Int
  english       String
  transcription String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  list       WordList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  phonemes   WordPhoneme[]
  activities ActivityWord[]

  @@index([listId])
}

/// One row per phoneme in a word.
/// `position` defines order (0-based). `symbol` stores the full IPA symbol
/// (may be multi-character: tʃ, dʒ, iː, æɪ, etc.).
model WordPhoneme {
  id       Int    @id @default(autoincrement())
  wordId   Int
  symbol   String
  position Int

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, position])
  @@index([wordId])
}

/// Type of activity the teacher can build.
enum ActivityType {
  WORDLE
  WORDSEARCH
}

/// A saved Wordle or Word Search configuration built from a WordList.
model Activity {
  id          Int          @id @default(autoincrement())
  name        String
  type        ActivityType
  difficulty  String       @default("medium")
  rows        Int?
  cols        Int?
  maxAttempts Int?
  listId      Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  list  WordList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  words ActivityWord[]

  @@index([listId])
}

/// Join table: which words belong to which activity.
model ActivityWord {
  activityId Int
  wordId     Int

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([activityId, wordId])
  @@index([wordId])
}

/// Global app settings (theme, default difficulty, etc.).
model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}


/// Tracks individual page visits and dwell time for observability.
/// One row is created when a user opens a page, and updated with the
/// time spent when they leave.
model PageVisit {
  id          Int      @id @default(autoincrement())
  path        String   // e.g. "/wordle", "/word-search"
  sessionId   String   // anonymous client-generated ID
  dwellMs     Int?     // milliseconds spent on page (null = still open)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([path])
  @@index([createdAt])
  @@index([sessionId])
}

/// Records every HTML activity generation attempt (success or failure).
model GenerationEvent {
  id           Int      @id @default(autoincrement())
  activityType String   // "WORDLE" | "WORDSEARCH"
  success      Boolean  // true = HTML generated, false = failed
  wordCount    Int      // number of words in the generated activity
  difficulty   String   // "easy" | "medium" | "hard"
  errorMessage String?  // populated only when success = false
  createdAt    DateTime @default(now())

  @@index([activityType])
  @@index([success])
  @@index([createdAt])
}

/// General event log for alerts, warnings, and unusual states.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  level     String   // "info" | "warn" | "error"
  source    String   // e.g. "wordle", "word-search", "api"
  message   String   // human-readable description
  metadata  String?  // optional JSON string for extra context
  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
}

